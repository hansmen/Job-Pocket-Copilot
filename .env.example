# Copy to apps/api/.env and fill in. Do not commit real values.

NODE_ENV=development
PORT=3000

# Postgres from docker-compose.yml
DATABASE_URL=postgresql://jobcopilot:jobcopilot@localhost:5432/jobcopilot?schema=public

# Authentication: "firebase" (prod) or "dev" (local, only NODE_ENV != production)
AUTH_MODE=dev
DEV_USER_ID=dev-user-1
FIREBASE_PROJECT_ID=
# Path to the service account JSON (file is in .gitignore) or the GOOGLE_APPLICATION_CREDENTIALS variable
GOOGLE_APPLICATION_CREDENTIALS=

# AI: start with "fake" (no cost), then "anthropic" or another provider
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL_PARSE=
LLM_MODEL_WRITE=

# The fake provider is free; the monthly threshold blocks new calls after reported spend reaches the limit.
# A final or concurrent provider call may exceed that threshold.
AI_DAILY_CALLS_PER_USER=30
AI_MONTHLY_BUDGET_USD=20

# Files (Stage 2): S3-compatible storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
