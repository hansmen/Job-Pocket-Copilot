// Server data model (Stage 2). Kept in sync with packages/shared/src/types.ts.
// IDs are generated by the client (UUIDv7) for offline creation, so we do not set @default.
// Times on the client are epoch ms; on the server we store DateTime (UTC) and convert in the API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  authUid   String   @unique // uid from Firebase Auth
  locale    String   @default("uk")
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs         Job[]
  applications Application[]
  profiles     Profile[]
  files        FileAsset[]
  aiUsage      AiUsage[]
}

model Job {
  id            String    @id
  userId        String
  url           String?
  company       String
  title         String
  rawText       String?
  parsed        Json?
  parserVersion String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId, updatedAt])
  @@index([userId, url])
}

model Application {
  id              String    @id
  userId          String
  jobId           String
  status          String
  appliedAt       DateTime?
  nextFollowUpAt  DateTime?
  resumeVersionId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  events    ApplicationEvent[]
  reminders Reminder[]

  @@index([userId, updatedAt])
  @@index([jobId])
}

model ApplicationEvent {
  id            String    @id
  applicationId String
  type          String
  fromStatus    String?
  toStatus      String?
  note          String?
  occurredAt    DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
}

model Reminder {
  id            String    @id
  applicationId String
  kind          String
  fireAt        DateTime
  doneAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, fireAt])
}

// Stage 2: the user's structured resume.
model Profile {
  id           String   @id
  userId       String
  data         Json
  sourceFileId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FileAsset {
  id         String    @id
  userId     String
  kind       String // resume | screenshot | export
  storageKey String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// AI call accounting: limits and cost control.
model AiUsage {
  id        String   @id @default(uuid())
  userId    String
  feature   String // parse_job | tailor_resume | interview_feedback ...
  model     String
  tokensIn  Int
  tokensOut Int
  costUsd   Decimal  @db.Decimal(10, 6)
  cached    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
